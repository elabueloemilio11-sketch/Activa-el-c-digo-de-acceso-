{
  "name": "abuelo-emilio-academy-access",
  "version": "1.0.0",
  "private": true,
  "description": "Secure Shopify-backed lifetime access gateway for Abuelo Emilio Academy",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "register:webhooks": "node scripts/register-webhooks.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "fastify": "5.12.3",
    "nodemailer": "10.0.1",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
