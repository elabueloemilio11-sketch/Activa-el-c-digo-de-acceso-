NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abuelo_emilio_academy

# Public URLs (no trailing slash)
APP_URL=http://localhost:3000
ACADEMY_URL=/academy
SHOPIFY_CHECKOUT_URL=https://academiaemilio.myshopify.com/cart/63469093847370:1

# Shopify custom app / webhook configuration
SHOPIFY_STORE_DOMAIN=academiaemilio.myshopify.com
SHOPIFY_WEBHOOK_SECRET=replace-with-shopify-app-client-secret
# Optional: only needed by npm run register:webhooks
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_me
SHOPIFY_API_VERSION=2026-07
SHOPIFY_PRODUCT_VARIANT_IDS=63469093847370

# Generate each secret independently: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
CODE_PEPPER=replace-with-at-least-32-random-characters
CODE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# resend | smtp | console (console is development-only)
EMAIL_PROVIDER=console
EMAIL_FROM=Abuelo Emilio Academy <acceso@example.com>
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

MAX_DEVICES=2
MAX_SESSIONS=2
SESSION_TTL_DAYS=30
DEVICE_TTL_DAYS=400
OTP_TTL_MINUTES=10
RECOVERY_TTL_MINUTES=20
COOKIE_DOMAIN=
TRUST_PROXY=true
